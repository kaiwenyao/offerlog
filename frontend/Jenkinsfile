// OfferLog frontend CI — modeled on eventpulse/frontend/Jenkinsfile.
// Kubernetes cloud agent; the Jenkins kubernetes-plugin injects the jnlp sidecar.
//   - node:   npm ci, tsc typecheck, Vitest unit tests, production build.
//   - docker: E2E through the repo's own Docker harness
//             (deploy/compose.test.yaml, profile "e2e") — a full application
//             stack (postgres + api + worker) plus a Playwright
//             runner container. On main, build & push the static frontend
//             tier ghcr.io/<user>/offerlog-web:<short-sha> from
//             deploy/web.Dockerfile (nginx serving the built SPA).
//   - gitops: on main, after the image push, bump the offerlog-web image line
//             in k3s-home/main (apps/offerlog/web-deployment.yaml) via
//             scripts/update-k3s-home.sh, the same flow backend/Jenkinsfile
//             uses for the api image. The split k8s deployment routes ingress
//             / to the web Service and /api straight to the api Service, so
//             frontend changes deploy independently of the api image
//             (publish stages share the changeset gate — backend-only
//             commits skip the web rebuild/bump).
//
// Cluster assumptions (same as eventpulse): cloud name `kubernetes` and a
// Docker-enabled node exposing /var/run/docker.sock.
pipeline {
    agent {
        kubernetes {
            cloud 'kubernetes'
            defaultContainer 'node'
            yaml '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    jenkins/label: offerlog-frontend-build
spec:
  containers:
    - name: node
      image: node:24-slim
      command:
        - sleep
      args:
        - "9999999"
      tty: true
      workingDir: /home/jenkins/agent
      resources:
        requests:
          cpu: "500m"
          memory: 2Gi
        limits:
          cpu: "2000m"
          memory: 4Gi
    - name: docker
      # docker:27-cli is Alpine and has /bin/sh; talks to the host-node daemon
      # through the mounted socket (compose harness builds + runs containers).
      image: docker:27-cli
      command:
        - sleep
      args:
        - "9999999"
      tty: true
      workingDir: /home/jenkins/agent
      resources:
        requests:
          cpu: "100m"
          memory: 128Mi
        limits:
          cpu: "500m"
          memory: 256Mi
      volumeMounts:
        - mountPath: /var/run/docker.sock
          name: docker-sock
        - mountPath: /ci-lock
          name: ci-lock
    - name: gitops
      # Same Git tooling and credentials as backend; no Docker socket needed.
      image: alpine:3.22
      command:
        - sh
        - -c
      args:
        - apk add --no-cache git ca-certificates && sleep 9999999
      tty: true
      workingDir: /home/jenkins/agent
      resources:
        requests:
          cpu: 100m
          memory: 128Mi
        limits:
          cpu: 500m
          memory: 256Mi
    # Keep the plugin's default image/connection args; bound the injected agent.
    - name: jnlp
      resources:
        requests:
          cpu: "100m"
          memory: 256Mi
        limits:
          cpu: "500m"
          memory: 512Mi
  volumes:
    - name: ci-lock
      # Cross-JOB mutex for the compose stage. The Lockable Resources plugin is
      # not installed on this controller, so the lock lives on the shared docker
      # host itself — which is exactly the resource being contended.
      hostPath:
        path: /var/cache/jenkins/lock
        type: DirectoryOrCreate
    - name: docker-sock
      hostPath:
        path: /var/run/docker.sock
'''
        }
    }

    options {
        skipDefaultCheckout()
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
        skipStagesAfterUnstable()
        // Keep the dockerized E2E stack and image publication ordered per job.
        disableConcurrentBuilds()
    }

    environment {
        CI = 'true'
        COMPOSE = 'docker compose -f deploy/compose.test.yaml'
        // Unique compose project per JOB *and* build — see the same block in
        // backend/Jenkinsfile: PR-N and its source branch are separate jobs
        // with separate build numbering, so $BUILD_NUMBER alone collides on
        // the shared host docker and one job's teardown kills the other's
        // stack mid-run.
        COMPOSE_PROJECT = "offerlog-ci-${env.JOB_NAME}-${env.BUILD_NUMBER}-e2e".toLowerCase().replaceAll(/[^a-z0-9_-]/, '-')
    }

    stages {
        stage('1. Pull Code') {
            steps {
                checkout scm
            }
        }

        stage('Frontend CI') {
            when {
                anyOf {
                    changeset pattern: 'frontend/**'
                    changeset pattern: 'deploy/**'
                    triggeredBy 'UserIdCause'
                    // A branch job's first build has no previous build to diff
                    // against, so the changeset is empty and no pattern above
                    // matches; run CI on that build instead of skipping it.
                    expression { currentBuild.previousBuild == null }
                }
            }
            stages {
                stage('2. Install, Typecheck, Unit Tests') {
                    steps {
                        container('node') {
                            dir('frontend') {
                                sh '''
                                set -eu
                                node --version
                                npm --version
                                npm ci
                                # tsc --noEmit: strict type gate, no emit
                                npx tsc --noEmit
                                # Vitest jsdom unit tests (status dictionary,
                                # formatting helpers) — no backend needed
                                npm test
                                '''
                            }
                        }
                    }
                }

                stage('3. Build') {
                    steps {
                        container('node') {
                            dir('frontend') {
                                sh '''
                                # npm run build = tsc -b && vite build (SPA into dist/)
                                npm run build
                                '''
                            }
                        }
                    }
                    post {
                        // An aborted build may lose the agent (pod gone) before
                        // post runs; workspace steps then throw
                        // MissingContextVariableException instead of archiving.
                        // Guard so cleanup never replaces the build result.
                        always {
                            script {
                                try {
                                    archiveArtifacts artifacts: 'frontend/dist/**', allowEmptyArchive: false
                                } catch (err) {
                                    echo("artifact archival skipped: ${err}")
                                }
                            }
                        }
                    }
                }

                stage('4. E2E (Docker Harness)') {
                    steps {
                        container('docker') {
                            sh '''
                            set -eu
                            # Full application stack + Playwright runner (PR #3
                            # harness): the test api opens registration
                            # (REGISTRATION_OPEN=true) and the e2e script signs
                            # up a one-off account; api serves the built SPA.
                            # --build is mandatory: compose only builds when
                            # the image is missing, so without it a rerun would
                            # silently reuse the previous commit's image (no
                            # register endpoint → e2e login timeout, PR #11
                            # build #3). Cross-job collisions are handled by
                            # $COMPOSE_PROJECT being job-unique.
                            # Serialize the heavy stage ACROSS jobs, and reap what earlier crashes left.
                            #
                            # disableConcurrentBuilds() only serializes within ONE job, but the
                            # multibranch pipeline runs PR-N and its source branch as separate jobs —
                            # and backend and frontend are separate pipelines — so a single push fired
                            # four full stacks (postgres + api + worker + playwright) plus four image
                            # builds at once. Those containers run on the HOST docker daemon through
                            # the mounted socket, so their memory is invisible to the k8s scheduler:
                            # the 4-core / 7.6GB / no-swap node oversubscribed silently until the
                            # kernel OOM-killed the (BestEffort) Jenkins controller, and the build
                            # died as "This commit cannot be built".
                            #
                            # flock, not the Lockable Resources plugin — that plugin is not installed
                            # here. Locking an FD (not `flock FILE CMD`) keeps the lock across both
                            # commands below without nesting quotes, and the kernel releases it when
                            # the shell exits, so an aborted build can never strand it. No -w: busybox
                            # flock silently rejects it and skips the command outright; the pipeline's
                            # own 30-minute timeout is the backstop for a wedged holder.
                            exec 9>/ci-lock/compose.lock
                            flock 9

                            # Reap stacks orphaned by a killed agent. post{} teardown never runs when
                            # the agent pod is OOM-killed, so a crashed build leaves its whole stack
                            # behind forever (one postgres had been up 29 hours). Those leaks add the
                            # memory pressure that triggers the NEXT OOM — the failure feeds itself,
                            # and this sweep breaks the loop.
                            #
                            # Safe only INSIDE the lock: the unique per-build project name exists so
                            # concurrent jobs do not tear down each other's stack, but while we hold
                            # the lock no other offerlog compose stack can be running, so anything
                            # else named offerlog-ci-* is by definition a leak. Selected by compose
                            # project label, so unrelated stacks sharing this host (firmament /
                            # joplin / nightdeal / ...) are never touched.
                            docker ps -a --filter "label=com.docker.compose.project" \
                                --format '{{.Label "com.docker.compose.project"}}' 2>/dev/null \
                              | sort -u | grep "^offerlog-ci-" | grep -v "^${COMPOSE_PROJECT}$" \
                              | while read -r stale; do
                                    echo "reaping orphaned CI stack: $stale"
                                    $COMPOSE -p "$stale" down -v --rmi local --remove-orphans || true
                                done

                            $COMPOSE -p $COMPOSE_PROJECT --profile e2e run --build --rm e2e
                            '''
                        }
                    }
                    post {
                        always {
                            script {
                                try {
                                    container('docker') {
                                        sh '''
                                        $COMPOSE -p $COMPOSE_PROJECT --profile e2e down -v --rmi local --remove-orphans || true
                                        '''
                                    }
                                } catch (err) {
                                    echo("compose teardown skipped: ${err}")
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('5. Build & Push Web Image') {
            when {
                branch 'main'
                // Split-deploy gate (mirror of backend stage 4): a
                // backend-only commit on main skips the web image rebuild +
                // web bump; UserIdCause/first-build always publish. deploy/**
                // stays coarse: both pipelines watch all of it.
                anyOf {
                    changeset pattern: 'frontend/**'
                    changeset pattern: 'deploy/**'
                    triggeredBy 'UserIdCause'
                    expression { currentBuild.previousBuild == null }
                }
            }
            steps {
                container('docker') {
                    script {
                        // Shared with eventpulse / nightdeal: usernamePassword
                        // `ghcr-token` (GitHub user + classic PAT with
                        // write:packages). Tag = commit short SHA — immutable,
                        // no `latest`.
                        withCredentials([usernamePassword(credentialsId: 'ghcr-token', usernameVariable: 'GHCR_USER', passwordVariable: 'GHCR_PASS')]) {
                            def gitCommit = (env.GIT_COMMIT ?: '').trim()
                            if (!(gitCommit ==~ /^[0-9a-f]{7,40}$/)) {
                                error("GIT_COMMIT is missing or invalid (got: ${gitCommit})")
                            }
                            env.FULL_IMAGE = "ghcr.io/${env.GHCR_USER.toLowerCase()}/offerlog-web:${gitCommit.take(7)}"
                            echo "Pushing ${env.FULL_IMAGE}"
                            sh 'echo "$GHCR_PASS" | docker login ghcr.io -u "$GHCR_USER" --password-stdin'
                            sh '''
                            # The static frontend tier: nginx serving the SPA.
                            # In the split k8s deployment the ingress routes /
                            # to this tier's Service (offerlog-web) while /api
                            # goes straight to the api Service — frontend
                            # changes deploy without touching the api image.
                            # (The compose single-entry deployment instead
                            # serves the SPA from the api image.)
                            docker build -f deploy/web.Dockerfile -t "$FULL_IMAGE" .
                            docker push "$FULL_IMAGE"
                            '''
                            sh 'docker logout ghcr.io'
                        }
                    }
                }
            }
        }

        stage('6. Update k3s-home') {
            when {
                // Identical to stage 5's gate: it consumes stage 5's
                // FULL_IMAGE, so the two must skip/run together.
                branch 'main'
                anyOf {
                    changeset pattern: 'frontend/**'
                    changeset pattern: 'deploy/**'
                    triggeredBy 'UserIdCause'
                    expression { currentBuild.previousBuild == null }
                }
            }
            steps {
                container('gitops') {
                    withCredentials([usernamePassword(
                        credentialsId: 'k3s-home-write',
                        usernameVariable: 'GITOPS_USER',
                        passwordVariable: 'GITOPS_TOKEN'
                    )]) {
                        sh 'sh scripts/update-k3s-home.sh frontend'
                    }
                }
            }
        }
    }

    post {
        always {
            // Safety net: remove this build's compose project if a later stage
            // blew up before teardown ran. An aborted build can reach post with
            // NO agent at all (kubernetes pod never provisioned or already
            // gone) — every step here then throws MissingContextVariableException
            // (hudson.FilePath missing). Guard each one so cleanup can never
            // mask the real build result.
            script {
                try {
                    container('docker') {
                        sh '''
                        $COMPOSE -p $COMPOSE_PROJECT --profile e2e down -v --rmi local --remove-orphans || true
                        '''
                    }
                } catch (err) {
                    echo("compose cleanup skipped: ${err}")
                }
                try {
                    cleanWs()
                } catch (err) {
                    echo("workspace cleanup skipped: ${err}")
                }
            }
        }
    }
}
