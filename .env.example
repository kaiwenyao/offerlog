# OfferLog 本地部署环境变量样例（对应 deploy/compose.local.yaml）。
#
# 用法：cp .env.example .env —— .env 是 make up 的必需文件（缺失会直接报错）；
# 默认值可直接用，按需修改。
# make 会检测根目录的 .env 并自动带上（--env-file .env）；绕过 make 直接跑
# docker compose 时请自行加 --env-file .env（compose 默认只读 compose 文件
# 旁边的 deploy/.env，不读仓库根目录）。
#
# 注意：POSTGRES_* 只在数据卷首次初始化时生效——改了口令要 `make down` 清掉
# 旧卷再 `make up`，否则数据库会认证失败（password authentication failed），
# 症状是 make up 报 postgres unhealthy / api 反复重启。

# --- 注册开关 ---
# 默认开放注册：登录页「注册」标签可自助开号；同时 make up 会自动建一个
# 本地测试账号（见下方 SEED_USER_*）。设 REGISTRATION_OPEN=false 后登录页只有
# 登录，账号用 api-admin create-user 建号（见 docs/runbook.md）。
REGISTRATION_OPEN=true

# --- make up 自动创建的本地测试账号 ---
# make up 最后会把账号密码打印在控制台；改这里即可换成自己的常用账号。
# 已存在的账号不会被改密码（避免把已登录的会话踢掉）。
# SEED_USER=0 则完全跳过自动建号。
# 也可临时覆盖而不改文件：make up SEED_USER_EMAIL=me@x.com
SEED_USER=1
SEED_USER_EMAIL=demo@offerlog.local
SEED_USER_PASSWORD=offerlog-demo-1234
SEED_USER_NAME=Demo User

# --- 应用 ---
APP_TIMEZONE=Europe/Dublin
CSRF_SECRET=local-only-change-me
LOG_LEVEL=info
PUBLIC_BASE=http://localhost:8080

# --- postgres（生效条件见顶部注意）---
POSTGRES_USER=offerlog
POSTGRES_PASSWORD=offerlog
POSTGRES_DB=offerlog
# --- 本地开发（可选）---
# 通过 npm run dev（Vite :5173）访问时，浏览器 Origin 仍是 :5173，而后端收到
# 的 Host 已被代理改写成 :8080，CSRF Origin 校验会把所有写请求判为跨源（403）。
# 仅在这种开发场景设置本变量（逗号分隔的额外 origin）；生产不要设置。
# 等价替代：前端 vite.config.ts 的 /api 代理已在转发时改写 Origin。
#DEV_ALLOWED_ORIGINS=http://localhost:5173

