# OfferLog 本地部署环境变量样例（对应 deploy/compose.local.yaml）。
#
# 用法：cp .env.example .env 后按需修改；不建 .env 也能直接 `make up`（全走默认值）。
# make 会检测根目录的 .env 并自动带上（--env-file .env）；绕过 make 直接跑
# docker compose 时请自行加 --env-file .env（compose 默认只读 compose 文件
# 旁边的 deploy/.env，不读仓库根目录）。
#
# 注意：POSTGRES_* 只在数据卷首次初始化时生效——改了口令要 `make down` 清掉
# 旧卷再 `make up`，否则数据库会认证失败（password authentication failed）。

# --- 首个账号（bootstrap 自动创建；账号已存在则跳过）---
LOCAL_ADMIN_EMAIL=me@example.com
LOCAL_ADMIN_PASSWORD=testpass12345
LOCAL_ADMIN_NAME=Owner

# --- 应用 ---
APP_TIMEZONE=Europe/Dublin
CSRF_SECRET=local-only-change-me
LOG_LEVEL=info
PUBLIC_BASE=http://localhost:8080

# --- postgres（生效条件见顶部注意）---
POSTGRES_USER=offerlog
POSTGRES_PASSWORD=offerlog
POSTGRES_DB=offerlog