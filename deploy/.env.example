# OfferLogs environment sample (plan §11). Copy to .env and fill secrets.
# Credentials are injected via environment/secret files — never commit real values.

# --- web ---
PUBLIC_BASE=https://offerlogs.example.com
APP_TIMEZONE=Europe/Dublin
CSRF_SECRET=replace-with-64-random-hex-chars

# --- postgres ---
POSTGRES_USER=offerlogs
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=offerlogs

# --- object storage ---
# local = container volume (default); s3 = existing SeaweedFS/S3 gateway
OBJECTSTORE_PROVIDER=local
S3_ENDPOINT=http://s3gateway:8333
S3_REGION=us-east-1
S3_BUCKET=offerlogs
S3_ACCESS_KEY=
S3_SECRET_KEY=
MAX_FILE_BYTES=20971520        # 20 MiB per file
FILE_QUOTA_BYTES=2147483648    # 2 GiB per user
CLEANUP_GRACE_HOURS=24

# --- misc ---
LOG_LEVEL=info
HTTP_ADDR=:8080
SESSION_HOURS=336
