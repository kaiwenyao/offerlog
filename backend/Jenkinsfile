// OfferLog backend CI — modeled on eventpulse/backend/Jenkinsfile.
// Kubernetes cloud agent; the Jenkins kubernetes-plugin injects the jnlp sidecar.
//   - go:     gofmt gate, go vet, build, and unit tests (everything except the
//             DB-backed integration suite).
//   - docker: integration tests run through the repo's own Docker harness
//             (deploy/compose.test.yaml, profile "integration") — a disposable
//             tmpfs postgres + the go test suite in containers. On main,
//             build & push the application image ghcr.io/<user>/offerlog-api:
//             <short-sha> from deploy/api.Dockerfile. The api binary still
//             embeds the frontend
//             SPA for the compose single-entry deployment — see the
//             Dockerfile — but the k8s deployment is split-tier: the cluster
//             serves the SPA from the separate web image built by
//             frontend/Jenkinsfile, and frontend-only commits no longer
//             rebuild/repush the api image (publish stages share the
//             changeset gate — see "Split-deploy gating" below).
//   - gitops: on main, after the image push, bump the offerlog-api image line
//             in k3s-home/main (apps/offerlog/api-deployment.yaml +
//             worker-deployment.yaml — both Deployments share this one image)
//             via scripts/update-k3s-home.sh, same flow as eventpulse. The
//             web tier's manifest is bumped by frontend/Jenkinsfile's gitops
//             stage.
//
// Split-deploy gating: the publish/gitops stages (4/5) share the test stage's
// changeset gate, so frontend-only commits skip the api image rebuild and the
// api/worker bump entirely (the cluster serves the SPA from the separate web
// tier; the embedded SPA is compose-only). deploy/** stays coarse on purpose:
// both pipelines watch all of it, so harness/Dockerfile changes just rebuild
// both images — harmless, and finer per-file routing isn't worth it yet.
//
// Cluster assumptions (same as eventpulse): cloud name `kubernetes`, a
// Docker-enabled node exposing /var/run/docker.sock (not plain containerd).
pipeline {
    agent {
        kubernetes {
            cloud 'kubernetes'
            defaultContainer 'go'
            yaml '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    jenkins/label: offerlog-backend-build
spec:
  containers:
    - name: go
      image: golang:1.25
      command:
        - sleep
      args:
        - "9999999"
      tty: true
      workingDir: /home/jenkins/agent
      resources:
        requests:
          cpu: "500m"
          memory: 1Gi
        limits:
          cpu: "2000m"
          memory: 3Gi
      volumeMounts:
        # Node-local caches shared by Go jobs (same pattern as the Maven repo
        # in eventpulse): second builds only recompile what changed.
        - mountPath: /go/pkg/mod
          name: go-mod
        - mountPath: /root/.cache/go-build
          name: go-build
    - name: docker
      # docker:27-cli is Alpine and has /bin/sh; talks to the host-node daemon
      # through the mounted socket (compose harness builds + runs containers).
      image: docker:27-cli
      command:
        - sleep
      args:
        - "9999999"
      tty: true
      workingDir: /home/jenkins/agent
      resources:
        requests:
          cpu: "100m"
          memory: 128Mi
        limits:
          cpu: "500m"
          memory: 256Mi
      volumeMounts:
        - mountPath: /var/run/docker.sock
          name: docker-sock
        - mountPath: /ci-lock
          name: ci-lock
    - name: gitops
      # Same Git tooling and credentials as eventpulse; no Docker socket needed.
      image: alpine:3.22
      command:
        - sh
        - -c
      args:
        - apk add --no-cache git ca-certificates && sleep 9999999
      tty: true
      workingDir: /home/jenkins/agent
      resources:
        requests:
          cpu: "100m"
          memory: 128Mi
        limits:
          cpu: "500m"
          memory: 256Mi
    # Keep the plugin's default image/connection args; bound the injected agent.
    - name: jnlp
      resources:
        requests:
          cpu: "100m"
          memory: 256Mi
        limits:
          cpu: "500m"
          memory: 512Mi
  volumes:
    - name: ci-lock
      # Cross-JOB mutex for the compose stage. The Lockable Resources plugin is
      # not installed on this controller, so the lock lives on the shared docker
      # host itself — which is exactly the resource being contended.
      hostPath:
        path: /var/cache/jenkins/lock
        type: DirectoryOrCreate
    - name: go-mod
      hostPath:
        path: /var/cache/jenkins/go/mod
        type: DirectoryOrCreate
    - name: go-build
      hostPath:
        path: /var/cache/jenkins/go/build
        type: DirectoryOrCreate
    - name: docker-sock
      hostPath:
        path: /var/run/docker.sock
'''
        }
    }

    options {
        skipDefaultCheckout()
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
        skipStagesAfterUnstable()
        // The compose harness uses fixed host-ports-free networks, but serialize
        // anyway so image publication and docker builds stay ordered per job.
        disableConcurrentBuilds()
    }

    environment {
        CI = 'true'
        COMPOSE = 'docker compose -f deploy/compose.test.yaml'
        // Unique compose project per JOB *and* build: the multibranch pipeline
        // runs PR-N and its source branch as two separate jobs, each with its
        // own build numbering, so a name keyed on $BUILD_NUMBER alone collides
        // (both are build #1) on the shared host docker. The loser's teardown
        // `down -v --remove-orphans` then rips out the winner's postgres and
        // network mid-run: the DB-backed packages never report and compose
        // exits 2. JOB_NAME carries the folder + branch; lowercase and squash
        // everything outside compose's [a-z0-9_-] charset.
        COMPOSE_PROJECT = "offerlog-ci-${env.JOB_NAME}-${env.BUILD_NUMBER}-integration".toLowerCase().replaceAll(/[^a-z0-9_-]/, '-')
    }

    stages {
        stage('1. Pull Code') {
            steps {
                checkout scm
            }
        }

        stage('Backend CI') {
            when {
                anyOf {
                    changeset pattern: 'backend/**'
                    changeset pattern: 'deploy/**'
                    triggeredBy 'UserIdCause'
                    // A branch job's first build has no previous build to diff
                    // against, so the changeset is empty and no pattern above
                    // matches; run CI on that build instead of skipping it.
                    expression { currentBuild.previousBuild == null }
                }
            }
            stages {
                stage('2. Format, Vet, Build, Unit Tests') {
                    steps {
                        container('go') {
                            dir('backend') {
                            sh '''
                            set -eu
                            # The workspace was checked out by the jnlp sidecar
                            # (uid 1000) while this container runs as root: git's
                            # dubious-ownership check rejects the repo, and go's
                            # default VCS stamping makes every `go build` die with
                            # "error obtaining VCS status: exit status 128". Trust
                            # the repo in this ephemeral build container, so the
                            # default stamping stays intact (`go version -m` on a
                            # built binary still shows the commit).
                            git config --global --add safe.directory '*'
                            go version
                                # gofmt gate: fail with the offending files listed
                                unformatted=$(gofmt -l .)
                                if [ -n "$unformatted" ]; then
                                    echo "gofmt needed on:" >&2; echo "$unformatted" >&2; exit 1
                                fi
                                go vet ./...
                                go build ./...
                                # Unit tests only; the DB-backed integration suite
                                # runs in the dockerized harness stage below.
                                go test $(go list ./... | grep -v /tests/integration) -count=1
                                '''
                            }
                        }
                    }
                }

                stage('3. Integration Tests (Docker Harness)') {
                    steps {
                        container('docker') {
                            sh '''
                            set -eu
                            # Disposable tmpfs postgres + go test container; the
                            # suite applies migrations itself (PR #3 harness).
                            # --build keeps the image in step with the source:
                            # compose only builds when the image is missing, so
                            # a rerun of this same job would otherwise test the
                            # previous commit. (Cross-job image collisions are
                            # handled by $COMPOSE_PROJECT being job-unique.)
                            # Serialize the heavy stage ACROSS jobs, and reap what earlier crashes left.
                            #
                            # disableConcurrentBuilds() only serializes within ONE job, but the
                            # multibranch pipeline runs PR-N and its source branch as separate jobs —
                            # and backend and frontend are separate pipelines — so a single push fired
                            # four full stacks (postgres + api + worker + playwright) plus four image
                            # builds at once. Those containers run on the HOST docker daemon through
                            # the mounted socket, so their memory is invisible to the k8s scheduler:
                            # the 4-core / 7.6GB / no-swap node oversubscribed silently until the
                            # kernel OOM-killed the (BestEffort) Jenkins controller, and the build
                            # died as "This commit cannot be built".
                            #
                            # flock, not the Lockable Resources plugin — that plugin is not installed
                            # here. Locking an FD (not `flock FILE CMD`) keeps the lock across both
                            # commands below without nesting quotes, and the kernel releases it when
                            # the shell exits, so an aborted build can never strand it. No -w: busybox
                            # flock silently rejects it and skips the command outright; the pipeline's
                            # own 30-minute timeout is the backstop for a wedged holder.
                            exec 9>/ci-lock/compose.lock
                            flock 9

                            # Reap stacks orphaned by a killed agent. post{} teardown never runs when
                            # the agent pod is OOM-killed, so a crashed build leaves its whole stack
                            # behind forever (one postgres had been up 29 hours). Those leaks add the
                            # memory pressure that triggers the NEXT OOM — the failure feeds itself,
                            # and this sweep breaks the loop.
                            #
                            # Safe only INSIDE the lock: the unique per-build project name exists so
                            # concurrent jobs do not tear down each other's stack, but while we hold
                            # the lock no other offerlog compose stack can be running, so anything
                            # else named offerlog-ci-* is by definition a leak. Selected by compose
                            # project label, so unrelated stacks sharing this host (firmament /
                            # joplin / nightdeal / ...) are never touched.
                            docker ps -a --filter "label=com.docker.compose.project" \
                                --format '{{.Label "com.docker.compose.project"}}' 2>/dev/null \
                              | sort -u | grep "^offerlog-ci-" | grep -v "^${COMPOSE_PROJECT}$" \
                              | while read -r stale; do
                                    echo "reaping orphaned CI stack: $stale"
                                    $COMPOSE -p "$stale" down -v --rmi local --remove-orphans || true
                                done

                            $COMPOSE -p $COMPOSE_PROJECT --profile integration run --build --rm integration
                            '''
                        }
                    }
                    post {
                        always {
                            script {
                                try {
                                    container('docker') {
                                        sh '''
                                        $COMPOSE -p $COMPOSE_PROJECT --profile integration down -v --rmi local --remove-orphans || true
                                        '''
                                    }
                                } catch (err) {
                                    echo("compose teardown skipped: ${err}")
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('4. Build & Push Image') {
            when {
                branch 'main'
                // Same gate as the test stage: a frontend-only commit on main
                // skips the api image rebuild + api/worker bump (the web tier
                // covers it), and UserIdCause/first-build always publish.
                anyOf {
                    changeset pattern: 'backend/**'
                    changeset pattern: 'deploy/**'
                    triggeredBy 'UserIdCause'
                    expression { currentBuild.previousBuild == null }
                }
            }
            steps {
                container('docker') {
                    script {
                        // Shared with eventpulse / nightdeal: usernamePassword
                        // `ghcr-token` (GitHub user + classic PAT with
                        // write:packages). Tag = commit short SHA — immutable,
                        // no `latest`.
                        withCredentials([usernamePassword(credentialsId: 'ghcr-token', usernameVariable: 'GHCR_USER', passwordVariable: 'GHCR_PASS')]) {
                            def gitCommit = (env.GIT_COMMIT ?: '').trim()
                            if (!(gitCommit ==~ /^[0-9a-f]{7,40}$/)) {
                                error("GIT_COMMIT is missing or invalid (got: ${gitCommit})")
                            }
                            env.FULL_IMAGE = "ghcr.io/${env.GHCR_USER.toLowerCase()}/offerlog-api:${gitCommit.take(7)}"
                            echo "Pushing ${env.FULL_IMAGE}"
                            sh 'echo "$GHCR_PASS" | docker login ghcr.io -u "$GHCR_USER" --password-stdin'
                            sh '''
                            # Build context is the repo root: the Dockerfile
                            # builds the SPA first, then the Go binaries, and
                            # the final image serves both (compose deployment).
                            docker build -f deploy/api.Dockerfile -t "$FULL_IMAGE" .
                            docker push "$FULL_IMAGE"
                            '''
                            sh 'docker logout ghcr.io'
                        }
                    }
                }
            }
        }

        stage('5. Update k3s-home') {
            when {
                // Identical to stage 4's gate: it consumes stage 4's
                // FULL_IMAGE, so the two must skip/run together.
                branch 'main'
                anyOf {
                    changeset pattern: 'backend/**'
                    changeset pattern: 'deploy/**'
                    triggeredBy 'UserIdCause'
                    expression { currentBuild.previousBuild == null }
                }
            }
            steps {
                container('gitops') {
                    withCredentials([usernamePassword(
                        credentialsId: 'k3s-home-write',
                        usernameVariable: 'GITOPS_USER',
                        passwordVariable: 'GITOPS_TOKEN'
                    )]) {
                        sh 'sh scripts/update-k3s-home.sh backend'
                    }
                }
            }
        }
    }

    post {
        always {
            // Safety net: if the build was killed between run and teardown,
            // remove this build's compose project and any leftover volumes.
            // An aborted build can reach post with NO agent at all (kubernetes
            // pod never provisioned or already gone) — every step here then
            // throws MissingContextVariableException (hudson.FilePath missing).
            // Guard each one so cleanup can never mask the real build result.
            script {
                try {
                    container('docker') {
                        sh '''
                        $COMPOSE -p $COMPOSE_PROJECT --profile integration down -v --rmi local --remove-orphans || true
                        '''
                    }
                } catch (err) {
                    echo("compose cleanup skipped: ${err}")
                }
                try {
                    cleanWs()
                } catch (err) {
                    echo("workspace cleanup skipped: ${err}")
                }
            }
        }
    }
}
